# ---- Login dashboard ----
DASHBOARD_USER=admin
# Hash bcrypt (cost 12). Buat dengan: npm run hash -- "password-anda"
# Di file .env, escape setiap $ menjadi \$ ; di dashboard Vercel tidak perlu.
DASHBOARD_PASS_HASH=
# Kunci penanda tangan sesi login, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Receiver (script / webhook yang mengirim data) ----
# Minimal 16 karakter acak. Kirim lewat header "x-api-key" (atau "Authorization: Bearer <key>" / "?key=<key>").
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RECEIVER_API_KEY=

# ---- Upstash Redis (salah satu pasangan) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Opsional ----
# Interval polling stream realtime dalam ms (2000-60000, default 5000)
# STREAM_INTERVAL_MS=5000
# Batas memori paket Redis dalam MB untuk persentase di dashboard (default 256)
# REDIS_MEMORY_LIMIT_MB=256
